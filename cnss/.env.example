# Environment context (dev/prod/test)
ENV=development
LOG_LEVEL=INFO

# HTTP API Server
CnSS_HOST=0.0.0.0
CnSS_HTTP_PORT=8000

# UDP Ingestion (CN -> CnSS)
CnSS_UDP_PORT=5140

# WebSocket (CnSS -> MUI)
CnSS_WS_PORT=8443

# Security (DO NOT use default in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400