# ==============================================================================
# CnSS Environment Configuration
# Template for all environment variables used by the CnSS microservices.
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# --- Network & Ingestion ---
# Port for the UDP Listener to receive TelemetryBatch payloads from Communication Nodes
CnSS_UDP_PORT=5140
# Maximum Transmission Unit constraint for UDP payloads (must be < 1400 bytes)
CnSS_UDP_MTU=1400
# Threshold for detecting abnormal backward jumps in sequence numbers (e.g., CN reboot)
SEQUENCE_RESET_THRESHOLD=1000000

# --- Redis Configuration ---
# Connection URL for the ephemeral Redis instance (no persistence)
# Use 'redis' if running inside Docker, or 'localhost' if running Python code directly on host
REDIS_URL=redis://redis:6379/0
# Maximum length of the Redis capped list for UDP buffering (prevents OOM if DB flusher lags)
REDIS_UDP_BUFFER_MAX_LEN=100000

# --- Database Configuration (TimescaleDB) ---
# Async connection URL for PostgreSQL/TimescaleDB
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# Note: Use 'localhost' instead of 'timescaledb' if you run Python scripts (like Alembic) outside Docker
DATABASE_URL=postgresql+asyncpg://cnss:cnss@timescaledb:5432/cnss

# --- Security & JWT ---
# Secret key for signing JWT tokens (HS256). MUST be changed in production!
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
# JWT signing algorithm
JWT_ALGORITHM=HS256
# Token expiration time in hours (default 24h)
JWT_EXPIRATION_HOURS=24

# --- Logging ---
# Global log level for all microservices (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# --- Service Hosts & Ports (Local Development) ---
# Host for local microservices binding
CnSS_HOST=0.0.0.0
# Port for the REST API and WebSocket services.
# FastAPI natively handles both HTTP and WS on the same port (matching legacy design).
# External routing (wss:// and https://) is handled by the Nginx reverse proxy.
# Note: This setting affects only local dev builds (make run-api).
CnSS_HTTP_PORT=8000

# --- Timeouts & Intervals ---
# Channel inactivity timeout in milliseconds (used for REST/WS fallback status)
ACTIVITY_TIMEOUT_MS=5000
# Interval in seconds for the Background Flusher to push Redis buffers to TimescaleDB
FLUSH_INTERVAL_SEC=1.0
# Interval in seconds for the Ghost Cleaner to scan and remove stale subscription listeners
GHOST_CLEANUP_INTERVAL_SEC=5.0
# Interval in seconds for the Reporting Worker's Cannel state syncer to sync drops and state to TimescaleDB
REPORTING_CAHNNEL_STATE_SYNCER_INTERVAL_SEC=1.0
# Interval in seconds for the Reporting Worker's Poller to process active subsribtions
REPORTING_POLLER_INTERVAL_SEC=1.0

# --- Data Retention ---
# Number of days to retain raw packet_flows data in TimescaleDB.
# Older data is automatically dropped by the retention policy.
RETENTION_DAYS=7