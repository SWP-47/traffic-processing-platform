# ==========================================
# CnSS Environment Configuration
# ==========================================

# --- Network & Ingestion ---
# Port for the UDP Listener to receive TelemetryBatch payloads from Communication Nodes
CnSS_UDP_PORT=9000

# --- Redis Configuration ---
# Connection URL for the ephemeral Redis instance (no persistence)
REDIS_URL=redis://redis:6379/0

# --- Database Configuration (TimescaleDB) ---
# Async connection URL for PostgreSQL/TimescaleDB
DATABASE_URL=postgresql+asyncpg://cnss:cnss_password@db:5432/cnss

# --- Security & JWT ---
# Secret key for signing JWT tokens (HS256). MUST be changed in production!
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
# JWT signing algorithm
JWT_ALGORITHM=HS256
# Token expiration time in hours (default 24h)
JWT_EXPIRATION_HOURS=24

# --- Logging ---
# Global log level for all microservices (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO